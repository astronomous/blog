---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<div class="main-window win95-inset">
				<div class="title-bar">
					<div class="title-bar-text">{title}</div>
					<div class="title-bar-controls">
						<div class="win95-button win95-raised">_</div>
						<div class="win95-button win95-raised">[]</div>
						<div class="win95-button win95-raised">X</div>
					</div>
				</div>
				<div class="window-content">
					<div class="post-meta">
						<span>Published on: <FormattedDate date={pubDate} /></span>
						{updatedDate && <span> | Last updated: <FormattedDate date={updatedDate} /></span>}
					</div>
					{
						tags &&
							tags.length > 0 && (
								<div class="tag-container">
									{tags.map((tag) => (
										<span class="tag-pill">{tag}</span>
									))}
								</div>
							)
					}
					<hr class="separator" />
					<slot />
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding: 60px 20px 20px; /* Account for fixed header */
	}
	.main-window {
		background: var(--content-bg);
		box-shadow: inset 1px 1px 0px var(--border-dark), inset -1px -1px 0px var(--border-light);
	}
	.title-bar {
		background: var(--title-bar-bg);
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 4px;
		color: var(--title-bar-text);
		font-weight: bold;
	}
	.title-bar-controls {
		display: flex;
	}
	.title-bar-controls .win95-button {
		width: 20px;
		height: 20px;
		line-height: 16px;
		padding: 0;
		margin-left: 2px;
		font-size: 10px;
		font-weight: bold;
	}
	.window-content {
		padding: 20px;
	}
	.post-meta {
		font-size: 11px;
		color: var(--text-color);
		opacity: 0.8;
		margin-bottom: 12px;
	}
	.tag-container {
		margin-bottom: 12px;
	}
	.tag-pill {
		display: inline-block;
		background: var(--tag-bg);
		border: 1px solid var(--tag-border);
		border-radius: 3px;
		padding: 2px 8px;
		font-size: 10px;
		margin: 2px;
		color: var(--text-color);
	}
	.separator {
		border: 0;
		border-top: 1px solid var(--border-dark);
		border-bottom: 1px solid var(--border-light);
		margin: 1rem 0;
	}
</style>